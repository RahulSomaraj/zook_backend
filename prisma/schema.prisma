// Zook backend — Prisma schema (Phase 1: users, vendors, KYC, catalog, products)
// Datasource is Supabase Postgres. Use the pooled URL for the app (DATABASE_URL)
// and the direct URL for migrations (DIRECT_URL).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums ──────────────────────────────────────────────────────────────

enum Role {
  customer
  vendor
  inspector
  admin
}

enum VendorStatus {
  pending
  approved
  suspended
}

enum KycStatus {
  pending
  approved
  rejected
}

enum ProductSource {
  vendor
  c2c
}

enum ConditionGrade {
  like_new
  good
  fair
  poor
}

enum AuthProvider {
  google
  apple
  supabase
}

enum InspectorStatus {
  pending
  active
  suspended
}

enum AvailabilityStatus {
  available
  busy
  offline
}

enum AdminStatus {
  active
  suspended
}

enum Emirate {
  abu_dhabi
  dubai
  sharjah
  ajman
  umm_al_quwain
  ras_al_khaimah
  fujairah
}

enum AdminLevel {
  support // L1 — read-mostly, handles tickets
  manager // L2 — approves KYC, manages vendors/inspectors
  super_admin // L3 — full platform control
}

// Lifecycle of a master catalog entry. `active` rows are visible to vendors
// when they add listings; `draft` rows are hidden from vendor search until an
// admin publishes them.
enum CatalogStatus {
  active
  draft
}

// Moderation state of an individual vendor/C2C product listing. New listings
// start `pending` and stay hidden from buyers until an admin `approved`s them;
// `rejected` listings are kept for audit but never shown.
enum ProductStatus {
  pending
  approved
  rejected
}

// Sub-order fulfilment state machine (shared by the vendor + admin order flows).
enum OrderStatus {
  confirmed // paid, awaiting packing
  preparing // vendor packing / uploading photos
  ready // photos verified, awaiting courier pickup
  shipped // in transit
  delivered
  cancelled
}

// Lifecycle of a vendor payout for a delivered sub-order.
enum PayoutStatus {
  pending // not yet earned (order not delivered)
  ready // delivered, VCC issuable
  held // frozen by fraud/strike action
  issued // VCC created via Mamo
  redeemed
}

// ── Models ─────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  phone         String?  @unique
  // Stored separately from `phone` so the dial code can be edited/displayed on
  // its own (e.g. "+971"). `phone` still holds the full E.164 number and stays
  // the unique lookup key used by the OTP flows.
  countryCode   String?  @map("country_code")
  fullName      String?  @map("full_name")
  avatarUrl     String?  @map("avatar_url")
  // Null for accounts created purely via a social provider (Google/Apple).
  passwordHash  String?  @map("password_hash")
  emailVerified Boolean  @default(false) @map("email_verified")
  phoneVerified Boolean  @default(false) @map("phone_verified")
  // Whether the user accepted the terms of service & privacy policy at signup.
  termsAccepted Boolean  @default(false) @map("terms_accepted")
  createdAt     DateTime @default(now()) @map("created_at")

  // A person can hold several roles at once (e.g. customer + vendor); the grant
  // set lives in user_roles, not a single column. Each role's operational data
  // (if any) lives in its 1-1 profile extension below.
  userRoles     UserRole[]
  vendor        Vendor?
  inspector     Inspector?
  admin         Admin?
  identities    AuthIdentity[]
  refreshTokens RefreshToken[]
  // Push notification device tokens (FCM) for this user's installs.
  deviceTokens DeviceToken[]
  // Customer shopping carts owned by this user (typically one active cart).
  carts Cart[]
  // Products this user has wishlisted.
  wishlistItems WishlistItem[]
  // Saved delivery addresses for customer checkout.
  addresses CustomerAddress[]
  // KYC records this user reviewed in their admin capacity.
  reviewedKyc VendorKyc[] @relation("KycReviewer")

  @@map("users")
}

// A grant of one role to one user. The many-to-many between users and the Role
// enum: a user with rows for {customer, vendor} can enter both of those apps.
model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      Role
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role]) // one grant per (user, role); makes grants idempotent
  @@index([userId])
  @@index([role])
  @@map("user_roles")
}

// Links a user to an external identity provider (Google/Apple). A user may have
// several (e.g. signed in with both Google and Apple, or password + social).
model AuthIdentity {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  provider       AuthProvider
  providerUserId String       @map("provider_user_id") // the provider's subject (sub)
  createdAt      DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_identities")
}

model Vendor {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @unique @map("user_id") @db.Uuid
  storeName      String       @map("store_name")
  storeLogoUrl   String?      @map("store_logo_url")
  description    String?
  phone          String?      @map("store_phone")
  coverImageUrl  String?      @map("cover_image_url")
  language       String?      @default("en")
  // Source of truth for the vendor's currency: the assigned country supplies
  // the currency shown across the store. `currency` mirrors country.currencyCode
  // for existing readers and is kept in sync whenever `countryId` changes.
  countryId      String?      @map("country_id") @db.Uuid
  currency       String?      @default("AED")
  storeAddress   String?      @map("store_address") // courier pickup only
  pickupArea     String?      @map("pickup_area")
  pickupEmirate  Emirate?     @map("pickup_emirate")
  pickupLat      Float?       @map("pickup_lat")
  pickupLng      Float?       @map("pickup_lng")
  commissionRate Decimal      @default(10.0) @map("commission_rate") @db.Decimal(5, 2)
  status         VendorStatus @default(pending)
  strikeCount    Int          @default(0) @map("strike_count")
  createdAt      DateTime     @default(now()) @map("created_at")
  // Soft delete: non-null means the vendor is archived and hidden from normal
  // queries. Restored by clearing this back to null.
  deletedAt      DateTime?    @map("deleted_at")

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  country   Country?    @relation(fields: [countryId], references: [id], onDelete: SetNull)
  kyc       VendorKyc[]
  products  Product[]
  subOrders SubOrder[]

  @@index([status])
  @@index([deletedAt])
  @@index([countryId])
  @@map("vendors")
}

// Inspector profile — operational data for users who hold the `inspector` role.
model Inspector {
  id                   String             @id @default(uuid()) @db.Uuid
  userId               String             @unique @map("user_id") @db.Uuid
  assignedZones        String[]           @map("assigned_zones") // region/emirate codes
  availabilityStatus   AvailabilityStatus @default(offline) @map("availability_status")
  ratingAvg            Decimal            @default(0.0) @map("rating_avg") @db.Decimal(3, 2)
  completedInspections Int                @default(0) @map("completed_inspections")
  status               InspectorStatus    @default(pending)
  createdAt            DateTime           @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([availabilityStatus])
  @@map("inspectors")
}

// Admin profile — for users who hold the `admin` role. Coarse `level` plus
// fine-grained `permissions` scope strings (e.g. "kyc:approve").
model Admin {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @unique @map("user_id") @db.Uuid
  department  String? // e.g. "operations", "finance", "support"
  level       AdminLevel  @default(support)
  permissions String[]    @default([]) // scope strings, e.g. ["kyc:approve","vendor:suspend"]
  status      AdminStatus @default(active)
  createdAt   DateTime    @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([level])
  @@index([status])
  @@map("admins")
}

model VendorKyc {
  id                 String    @id @default(uuid()) @db.Uuid
  vendorId           String    @map("vendor_id") @db.Uuid
  tradeLicenseUrl    String    @map("trade_license_url") // private bucket
  tradeLicenseNumber String?   @map("trade_license_number")
  tradeLicenseExpiry DateTime? @map("trade_license_expiry") @db.Date
  emiratesIdFrontUrl String    @map("emirates_id_front_url") // private bucket
  emiratesIdBackUrl  String    @map("emirates_id_back_url") // private bucket
  status             KycStatus @default(pending)
  reviewedBy         String?   @map("reviewed_by") @db.Uuid // admin user id
  rejectionReason    String?   @map("rejection_reason")
  reviewedAt         DateTime? @map("reviewed_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  // The reviewing admin (a user). FK guarantees a real user; "is an admin" is a
  // service-layer check. SetNull keeps the audit row if the admin is deleted.
  reviewer User?  @relation("KycReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([vendorId])
  @@index([status])
  @@map("vendor_kyc")
}

// A manufacturer/brand (e.g. Apple, Samsung). Normalized out of ProductCatalog
// so the admin can manage the vendor-facing dropdown without a deploy and so
// spellings stay consistent. Soft-deletable; `isActive` toggles dropdown
// visibility without archiving.
model Brand {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  slug      String    @unique
  logoUrl   String?   @map("logo_url")
  isActive  Boolean   @default(true) @map("is_active")
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  catalog ProductCatalog[]

  @@index([isActive])
  @@index([deletedAt])
  @@map("brands")
}

// A product category (e.g. Smartphones, Laptops). Same rationale as Brand;
// `icon` holds the emoji/glyph the admin UI shows beside each category.
model Category {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  slug      String    @unique
  icon      String?
  isActive  Boolean   @default(true) @map("is_active")
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  catalog ProductCatalog[]

  @@index([isActive])
  @@index([deletedAt])
  @@map("categories")
}

// A supported country and the currency shown to users in it. Currency lives as
// fields here (not a separate table) because many countries can share a
// currency, and the app always resolves currency *through* a country. Same
// admin lifecycle as Brand/Category: soft-delete (archive + restore) and an
// `isActive` flag that hides a country from the public list without archiving.
model Country {
  id             String    @id @default(uuid()) @db.Uuid
  name           String    @unique // "United Arab Emirates"
  iso2           String    @unique // ISO 3166-1 alpha-2, e.g. "AE"
  dialCode       String?   @map("dial_code") // "+971"
  currencyCode   String    @map("currency_code") // ISO 4217, e.g. "AED"
  currencyName   String    @map("currency_name") // "UAE Dirham"
  currencySymbol String    @map("currency_symbol") // "د.إ"
  // Multiplier from the base currency (AED). localPrice = basePrice * exchangeRate.
  exchangeRate   Decimal   @default(1.0) @map("exchange_rate") @db.Decimal(18, 6)
  // The fallback country used when a user has not chosen one. At most one row
  // should have this set; the app treats the first active default as canonical.
  isDefault      Boolean   @default(false) @map("is_default")
  isActive       Boolean   @default(true) @map("is_active")
  sortOrder      Int       @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at")
  deletedAt      DateTime? @map("deleted_at")

  vendors Vendor[]

  @@index([isActive])
  @@index([deletedAt])
  @@map("countries")
}

model ProductCatalog {
  id            String        @id @default(uuid()) @db.Uuid
  brandId       String        @map("brand_id") @db.Uuid
  model         String
  year          Int?
  categoryId    String        @map("category_id") @db.Uuid
  stockImageUrl String?       @map("stock_image_url") // official manufacturer photo
  // Free-form variant + spec data shown to buyers. Conventionally:
  //   { "storage": [...], "colors": [...], "keySpecs": [...] }
  specs         Json?
  description   String?
  status        CatalogStatus @default(active)
  createdAt     DateTime      @default(now()) @map("created_at")
  // Soft delete: a non-null value archives the entry and hides it from normal
  // queries (restorable by clearing the column), mirroring the Vendor model.
  deletedAt     DateTime?     @map("deleted_at")

  // Brand/category are restricted on delete: they are soft-deleted, so a
  // referenced row always still exists and listings are never orphaned.
  brand          Brand                  @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category       Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  products       Product[]
  specifications ProductSpecification[]

  @@unique([brandId, model, year])
  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([deletedAt])
  @@map("product_catalog")
}

// Normalized, buyer-facing specifications for a catalog entry (e.g. "Display" →
// "6.1\" Super Retina XDR"). One catalog entry has many spec rows, ordered by
// `sortOrder`. `label` is unique per catalog so a spec has a single value.
// Cascade-deleted with the catalog entry, unlike the free-form `specs` JSON.
model ProductSpecification {
  id        String   @id @default(uuid()) @db.Uuid
  catalogId String   @map("catalog_id") @db.Uuid
  label     String // attribute name, e.g. "Chipset"
  value     String // attribute value, e.g. "A16 Bionic"
  group     String? // optional section, e.g. "Display"
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  catalog ProductCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)

  @@unique([catalogId, label])
  @@index([catalogId])
  @@map("product_specifications")
}

model Product {
  id               String         @id @default(uuid()) @db.Uuid
  vendorId         String?        @map("vendor_id") @db.Uuid // null if C2C
  catalogId        String         @map("catalog_id") @db.Uuid
  source           ProductSource
  conditionGrade   ConditionGrade @map("condition_grade")
  storageVariant   String?        @map("storage_variant")
  color            String?
  inspectionImages String[]       @map("inspection_images") // real photos
  description      String?
  whatIsIncluded   Json?          @map("what_is_included")
  price            Decimal        @db.Decimal(10, 2)
  stockQty         Int            @default(1) @map("stock_qty")
  status           ProductStatus  @default(pending)
  rejectionReason  String?        @map("rejection_reason") // set when status = rejected
  isActive         Boolean        @default(true) @map("is_active")
  createdAt        DateTime       @default(now()) @map("created_at")

  vendor        Vendor?        @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  catalog       ProductCatalog @relation(fields: [catalogId], references: [id])
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  subOrders     SubOrder[]

  @@index([vendorId])
  @@index([catalogId])
  @@index([status])
  @@index([isActive])
  @@map("products")
}

// ── Orders ─────────────────────────────────────────────────────────────
// One parent Order per checkout, split into one SubOrder per product per
// vendor (the admin-facing unit). Rates are snapshotted onto the sub-order at
// sale time so historical payouts never move when a vendor's rate changes.

model Cart {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([userId])
  @@index([isActive])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

model WishlistItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("wishlist_items")
}

model CustomerAddress {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  fullName   String   @map("full_name")
  phone      String
  label      String?  // e.g. Home, Work
  line1      String
  line2      String?
  city       String
  state      String?
  country    String
  postalCode String?  @map("postal_code")
  landmark   String?
  latitude   Float?
  longitude  Float?
  isActive   Boolean  @default(true) @map("is_active")
  isDefault  Boolean  @default(false) @map("is_default")
  createdBy  String?  @map("created_by") @db.Uuid
  updatedBy  String?  @map("updated_by") @db.Uuid
  deletedBy  String?  @map("deleted_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@index([isActive])
  @@index([isDefault])
  @@index([deletedAt])
  @@map("customer_addresses")
}

model Order {
  id                  String    @id @default(uuid()) @db.Uuid
  orderNumber         String    @unique @map("order_number") // human ref e.g. ORD-041
  customerId          String    @map("customer_id") @db.Uuid // users.id
  addressId           String?   @map("address_id") @db.Uuid
  subtotal            Decimal   @db.Decimal(10, 2)
  deliveryFee         Decimal   @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  totalAmount         Decimal   @map("total_amount") @db.Decimal(10, 2)
  paymentId           String?   @map("payment_id") @db.Uuid // Payment row (Gap F)
  estimatedDeliveryAt DateTime? @map("estimated_delivery_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  address   CustomerAddress? @relation(fields: [addressId], references: [id], onDelete: SetNull)
  subOrders SubOrder[]

  @@index([customerId])
  @@index([addressId])
  @@map("orders")
}

model SubOrder {
  id                 String       @id @default(uuid()) @db.Uuid
  subOrderNumber     String       @unique @map("sub_order_number")
  orderId            String       @map("order_id") @db.Uuid
  vendorId           String?      @map("vendor_id") @db.Uuid // null for C2C
  productId          String       @map("product_id") @db.Uuid
  status             OrderStatus  @default(confirmed)
  salePrice          Decimal      @map("sale_price") @db.Decimal(10, 2)
  commissionRate     Decimal      @map("commission_rate") @db.Decimal(5, 2) // snapshot at sale time
  processingFee      Decimal      @map("processing_fee") @db.Decimal(10, 2) // Mamo ~2.9%
  payoutAmount       Decimal      @map("payout_amount") @db.Decimal(10, 2)
  payoutStatus       PayoutStatus @default(pending) @map("payout_status")
  courierName        String?      @map("courier_name") // Porter.ae, Jeebly…
  awbNumber          String?      @map("awb_number")
  packPhotoBeforeUrl String?      @map("pack_photo_before_url")
  packPhotoAfterUrl  String?      @map("pack_photo_after_url")
  // Set once BOTH packing photos have been uploaded.
  photosVerifiedAt      DateTime?         @map("photos_verified_at")
  deliveredAt        DateTime?    @map("delivered_at")
  cancelledAt        DateTime?    @map("cancelled_at")
  createdAt          DateTime     @default(now()) @map("created_at")

  order         Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor        Vendor?                 @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  product       Product                 @relation(fields: [productId], references: [id])
  statusHistory SubOrderStatusHistory[]

  @@index([status])
  @@index([vendorId])
  @@index([payoutStatus])
  @@index([createdAt])
  @@map("sub_orders")
}

// Append-only ledger powering timelines + "time in status" on the admin table.
model SubOrderStatusHistory {
  id         String      @id @default(uuid()) @db.Uuid
  subOrderId String      @map("sub_order_id") @db.Uuid
  status     OrderStatus
  actorId    String?     @map("actor_id") @db.Uuid // user who caused it (vendor/admin/system=null)
  note       String?
  createdAt  DateTime    @default(now()) @map("created_at")

  subOrder SubOrder @relation(fields: [subOrderId], references: [id], onDelete: Cascade)

  @@index([subOrderId])
  @@map("sub_order_status_history")
}

// ── Refresh token store ────────────────────────────────────────────────
// One row per issued refresh token (identified by its jti). Logout revokes
// the row; /auth/refresh rejects revoked or missing jtis (token rotation).
model RefreshToken {
  id        String    @id @default(cuid())
  jti       String    @unique
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

// ── Phone OTP verification ─────────────────────────────────────────────
// One row per OTP issued to a phone number. The code is stored hashed; rows
// expire and are single-use. Powers vendor phone-OTP login & signup.
model PhoneVerification {
  id         String    @id @default(uuid()) @db.Uuid
  phone      String
  codeHash   String    @map("code_hash") // bcrypt hash of the OTP
  purpose    String    @default("vendor_auth") // why the code was issued
  expiresAt  DateTime  @map("expires_at")
  attempts   Int       @default(0) // failed verification attempts
  consumedAt DateTime? @map("consumed_at") // set once successfully used
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([phone])
  @@index([expiresAt])
  @@map("phone_verifications")
}

// ── Push notification device tokens ────────────────────────────────────
// One row per app install/device that opted into push. Powers FCM delivery
// of onboarding-approval notifications when the mobile app is backgrounded
// or closed (Supabase Realtime only reaches connected, foregrounded apps).
// The `token` is the FCM registration token; it's unique and refreshed by
// the client. Rows are pruned when FCM reports a token as unregistered.
model DeviceToken {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  token     String         @unique // FCM registration token
  platform  DevicePlatform
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

enum DevicePlatform {
  ios
  android
  web
}