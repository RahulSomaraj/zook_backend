// Zook backend — Prisma schema (Phase 1: users, vendors, KYC, catalog, products)
// Datasource is Supabase Postgres. Use the pooled URL for the app (DATABASE_URL)
// and the direct URL for migrations (DIRECT_URL).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums ──────────────────────────────────────────────────────────────

enum Role {
  customer
  vendor
  inspector
  admin
}

enum VendorStatus {
  pending
  approved
  suspended
}

enum KycStatus {
  pending
  approved
  rejected
}

enum ProductSource {
  vendor
  c2c
}

enum ConditionGrade {
  like_new
  good
  fair
  poor
}

enum AuthProvider {
  google
  apple
  supabase
}

enum InspectorStatus {
  pending
  active
  suspended
}

enum AvailabilityStatus {
  available
  busy
  offline
}

enum AdminStatus {
  active
  suspended
}

enum AdminLevel {
  support // L1 — read-mostly, handles tickets
  manager // L2 — approves KYC, manages vendors/inspectors
  super_admin // L3 — full platform control
}

// ── Models ─────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  phone         String?  @unique
  fullName      String?  @map("full_name")
  avatarUrl     String?  @map("avatar_url")
  // Null for accounts created purely via a social provider (Google/Apple).
  passwordHash  String?  @map("password_hash")
  emailVerified Boolean  @default(false) @map("email_verified")
  phoneVerified Boolean  @default(false) @map("phone_verified")
  createdAt     DateTime @default(now()) @map("created_at")

  // A person can hold several roles at once (e.g. customer + vendor); the grant
  // set lives in user_roles, not a single column. Each role's operational data
  // (if any) lives in its 1-1 profile extension below.
  userRoles     UserRole[]
  vendor        Vendor?
  inspector     Inspector?
  admin         Admin?
  identities    AuthIdentity[]
  refreshTokens RefreshToken[]
  // Push notification device tokens (FCM) for this user's installs.
  deviceTokens DeviceToken[]
  // KYC records this user reviewed in their admin capacity.
  reviewedKyc VendorKyc[] @relation("KycReviewer")

  @@map("users")
}

// A grant of one role to one user. The many-to-many between users and the Role
// enum: a user with rows for {customer, vendor} can enter both of those apps.
model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      Role
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role]) // one grant per (user, role); makes grants idempotent
  @@index([userId])
  @@index([role])
  @@map("user_roles")
}

// Links a user to an external identity provider (Google/Apple). A user may have
// several (e.g. signed in with both Google and Apple, or password + social).
model AuthIdentity {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  provider       AuthProvider
  providerUserId String       @map("provider_user_id") // the provider's subject (sub)
  createdAt      DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_identities")
}

model Vendor {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @unique @map("user_id") @db.Uuid
  storeName      String       @map("store_name")
  storeLogoUrl   String?      @map("store_logo_url")
  storeAddress   String?      @map("store_address") // courier pickup only
  pickupLat      Float?       @map("pickup_lat")
  pickupLng      Float?       @map("pickup_lng")
  commissionRate Decimal      @default(10.0) @map("commission_rate") @db.Decimal(5, 2)
  status         VendorStatus @default(pending)
  strikeCount    Int          @default(0) @map("strike_count")
  createdAt      DateTime     @default(now()) @map("created_at")
  // Soft delete: non-null means the vendor is archived and hidden from normal
  // queries. Restored by clearing this back to null.
  deletedAt      DateTime?    @map("deleted_at")

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  kyc      VendorKyc[]
  products Product[]

  @@index([status])
  @@index([deletedAt])
  @@map("vendors")
}

// Inspector profile — operational data for users who hold the `inspector` role.
model Inspector {
  id                   String             @id @default(uuid()) @db.Uuid
  userId               String             @unique @map("user_id") @db.Uuid
  assignedZones        String[]           @map("assigned_zones") // region/emirate codes
  availabilityStatus   AvailabilityStatus @default(offline) @map("availability_status")
  ratingAvg            Decimal            @default(0.0) @map("rating_avg") @db.Decimal(3, 2)
  completedInspections Int                @default(0) @map("completed_inspections")
  status               InspectorStatus    @default(pending)
  createdAt            DateTime           @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([availabilityStatus])
  @@map("inspectors")
}

// Admin profile — for users who hold the `admin` role. Coarse `level` plus
// fine-grained `permissions` scope strings (e.g. "kyc:approve").
model Admin {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @unique @map("user_id") @db.Uuid
  department  String? // e.g. "operations", "finance", "support"
  level       AdminLevel  @default(support)
  permissions String[]    @default([]) // scope strings, e.g. ["kyc:approve","vendor:suspend"]
  status      AdminStatus @default(active)
  createdAt   DateTime    @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([level])
  @@index([status])
  @@map("admins")
}

model VendorKyc {
  id                 String    @id @default(uuid()) @db.Uuid
  vendorId           String    @map("vendor_id") @db.Uuid
  tradeLicenseUrl    String    @map("trade_license_url") // private bucket
  tradeLicenseNumber String?   @map("trade_license_number")
  tradeLicenseExpiry DateTime? @map("trade_license_expiry") @db.Date
  emiratesIdFrontUrl String    @map("emirates_id_front_url") // private bucket
  emiratesIdBackUrl  String    @map("emirates_id_back_url") // private bucket
  status             KycStatus @default(pending)
  reviewedBy         String?   @map("reviewed_by") @db.Uuid // admin user id
  rejectionReason    String?   @map("rejection_reason")
  reviewedAt         DateTime? @map("reviewed_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  // The reviewing admin (a user). FK guarantees a real user; "is an admin" is a
  // service-layer check. SetNull keeps the audit row if the admin is deleted.
  reviewer User?  @relation("KycReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([vendorId])
  @@index([status])
  @@map("vendor_kyc")
}

model ProductCatalog {
  id            String   @id @default(uuid()) @db.Uuid
  brand         String
  model         String
  year          Int?
  category      String
  stockImageUrl String?  @map("stock_image_url") // official manufacturer photo
  specs         Json? // storage, display, battery...
  createdAt     DateTime @default(now()) @map("created_at")

  products Product[]

  @@unique([brand, model, year])
  @@index([category])
  @@map("product_catalog")
}

model Product {
  id               String         @id @default(uuid()) @db.Uuid
  vendorId         String?        @map("vendor_id") @db.Uuid // null if C2C
  catalogId        String         @map("catalog_id") @db.Uuid
  source           ProductSource
  conditionGrade   ConditionGrade @map("condition_grade")
  storageVariant   String?        @map("storage_variant")
  color            String?
  inspectionImages String[]       @map("inspection_images") // real photos
  description      String?
  whatIsIncluded   Json?          @map("what_is_included")
  price            Decimal        @db.Decimal(10, 2)
  stockQty         Int            @default(1) @map("stock_qty")
  isActive         Boolean        @default(true) @map("is_active")
  createdAt        DateTime       @default(now()) @map("created_at")

  vendor  Vendor?        @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  catalog ProductCatalog @relation(fields: [catalogId], references: [id])

  @@index([vendorId])
  @@index([catalogId])
  @@index([isActive])
  @@map("products")
}

// ── Refresh token store ────────────────────────────────────────────────
// One row per issued refresh token (identified by its jti). Logout revokes
// the row; /auth/refresh rejects revoked or missing jtis (token rotation).
model RefreshToken {
  id        String    @id @default(cuid())
  jti       String    @unique
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

// ── Phone OTP verification ─────────────────────────────────────────────
// One row per OTP issued to a phone number. The code is stored hashed; rows
// expire and are single-use. Powers vendor phone-OTP login & signup.
model PhoneVerification {
  id         String    @id @default(uuid()) @db.Uuid
  phone      String
  codeHash   String    @map("code_hash") // bcrypt hash of the OTP
  purpose    String    @default("vendor_auth") // why the code was issued
  expiresAt  DateTime  @map("expires_at")
  attempts   Int       @default(0) // failed verification attempts
  consumedAt DateTime? @map("consumed_at") // set once successfully used
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([phone])
  @@index([expiresAt])
  @@map("phone_verifications")
}

// ── Push notification device tokens ────────────────────────────────────
// One row per app install/device that opted into push. Powers FCM delivery
// of onboarding-approval notifications when the mobile app is backgrounded
// or closed (Supabase Realtime only reaches connected, foregrounded apps).
// The `token` is the FCM registration token; it's unique and refreshed by
// the client. Rows are pruned when FCM reports a token as unregistered.
model DeviceToken {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  token     String         @unique // FCM registration token
  platform  DevicePlatform
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

enum DevicePlatform {
  ios
  android
  web
}
