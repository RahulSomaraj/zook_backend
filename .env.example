# ── App ──
NODE_ENV=development
PORT=3000
# error | warn | log | debug | verbose
LOG_LEVEL=debug
# pretty (dev) | json (prod)
LOG_FORMAT=pretty

# ── Database (Supabase Postgres) ──
# Use the connection pooler URL for the app, direct URL for migrations.
DATABASE_URL="postgresql://postgres:[password]@[host]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[password]@[host]:5432/postgres"

# ── Supabase ──
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret from Supabase project settings (used to verify access tokens)
SUPABASE_JWT_SECRET=

# ── CORS ──
# Comma-separated allowlist of browser origins. Leave empty in prod until the
# portal domains are known. Dev adds localhost:3000/5173 automatically.
# e.g. CORS_ORIGINS=https://admin.zook.ae,https://vendor.zook.ae
CORS_ORIGINS=

# ── Rate limiting ──
# Window in milliseconds and max requests per window, per client IP.
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ── Swagger ──
# Leave unset to enable outside production and disable in production.
# Set explicitly to true/false to override.
# SWAGGER_ENABLED=true
SWAGGER_PATH=docs
