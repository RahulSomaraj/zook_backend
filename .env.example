# ── App ──
NODE_ENV=development
PORT=3000
# error | warn | log | debug | verbose
LOG_LEVEL=debug
# pretty (dev) | json (prod)
LOG_FORMAT=pretty

# ── Database (Azure Database for PostgreSQL) ──
# DATABASE_URL is used by the app; DIRECT_URL by Prisma migrations (optional if
# the same). sslmode=require is typical for Azure Postgres.
DATABASE_URL="postgresql://user:[password]@[host].postgres.database.azure.com:5432/zook?sslmode=require"
DIRECT_URL="postgresql://user:[password]@[host].postgres.database.azure.com:5432/zook?sslmode=require"

# ── Auth (app-issued JWTs) ──
# Secret used to sign/verify our own access + refresh tokens. Min 32 chars.
# Generate e.g. with: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Social sign-in ──
# Comma-separated allowlists of accepted token audiences (client IDs).
# Google: the OAuth client ID(s) that minted the id_token.
GOOGLE_CLIENT_IDS=
# Apple: your app's bundle ID and/or Services ID.
APPLE_CLIENT_IDS=

# ── Supabase Auth (also powers Google social login) ──
# The client signs in with Google via Supabase and sends us the resulting
# Supabase access_token; we verify it and issue our own session JWTs.
# For social login: enable the Google provider in Supabase (Auth → Providers).
# Endpoints: POST /api/auth/customer/social/google and
#            POST /api/auth/vendor/social/google  (body: { supabaseAccessToken }).
# Project URL, e.g. https://abcdefgh.supabase.co (Project Settings → API).
# REQUIRED for social login (used to derive the token issuer + JWKS).
SUPABASE_URL=
# Only for legacy HS256 projects (Project Settings → API → JWT Secret). When set,
# tokens are verified with this secret; otherwise they're verified via the
# project JWKS derived from SUPABASE_URL. Leave empty for asymmetric projects.
SUPABASE_JWT_SECRET=

# ── Supabase Storage (signed URLs) ──
# Service-role key (Project Settings → API → service_role). Server-only:
# bypasses RLS, used to mint signed upload/download URLs. NEVER expose to clients.
SUPABASE_SERVICE_ROLE_KEY=
# Optional dedicated storage host for faster large uploads. If empty, falls
# back to SUPABASE_URL. e.g. https://abcdefgh.storage.supabase.co
SUPABASE_STORAGE_URL=

# ── Admin ──
# Comma-separated emails granted the admin role when they sign in via Supabase.
# Authoritative — clients can never self-assign admin — and this is how the
# first admin is bootstrapped. e.g. ADMIN_EMAILS=ops@zook.ae,founder@zook.ae
ADMIN_EMAILS=

# Bootstrap credentials for scripts/create-admin.js (provisions an admin row
# directly in the DB). Script-only — not validated at boot. Can also be passed
# inline per run instead of set here.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# ── CORS ──
# Comma-separated allowlist of browser origins. Leave empty in prod until the
# portal domains are known. Dev adds localhost:3000/5173 automatically.
# e.g. CORS_ORIGINS=https://admin.zook.ae,https://vendor.zook.ae
CORS_ORIGINS=

# ── Rate limiting ──
# Window in milliseconds and max requests per window, per client IP.
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ── Redis ──
# Connection URL. redis://[:password@]host:port[/db] — use rediss:// for TLS
# (Azure Cache for Redis requires TLS). Backs the per-phone OTP cooldown/daily
# cap and distributed request throttling. If empty, those degrade safely.
# e.g. rediss://:<access-key>@zook.redis.cache.windows.net:6380
REDIS_URL=

# ── OTP ──
# Delivery provider per audience: twilio_verify | local.
# 'local' = self-managed 6-digit codes stored (bcrypt-hashed) in Postgres and
# logged instead of sent. 'twilio_verify' = Twilio owns code + delivery.
# Development/test only: forces both audiences to local and returns `devCode`
# from the OTP request API, allowing any valid phone number to be tested.
# The application rejects OTP_TEST_MODE=true when NODE_ENV=production.
OTP_TEST_MODE=false
OTP_CUSTOMER_PROVIDER=twilio_verify
OTP_VENDOR_PROVIDER=local
# Local-provider code lifetime (seconds). Twilio owns its own TTL.
OTP_TTL_SECONDS=300
# Anti-abuse (enforced in Redis, before any paid send):
# min seconds between sends to the same phone, and max sends/phone/day.
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_DAILY_MAX_PER_PHONE=5

# ── Twilio (required when any OTP_*_PROVIDER=twilio_verify) ──
# Console → Account Info. Account SID starts with AC…
TWILIO_ACCOUNT_SID=
# Console → Account Info → Auth Token. Prefer a scoped API key in production.
TWILIO_AUTH_TOKEN=
# Verify → Services → your service SID (starts with VA…). In the console set
# code length to 6 digits and enable Fraud Guard + geo-permissions (UAE +
# countries you serve).
TWILIO_VERIFY_SERVICE_SID=
# Shown to the client for the countdown; match your Verify service TTL.
TWILIO_VERIFY_TTL_SECONDS=600
# Network timeout (ms) for Twilio API calls.
TWILIO_TIMEOUT_MS=8000

# ── Firebase / FCM ──
# Service-account key for sending push notifications via FCM.
# Firebase console → Project Settings → Service Accounts → Generate new private key.
# Paste the downloaded JSON as a single line (jq -c . service-account.json).
# When absent the backend skips push silently; Supabase Realtime still works.
FIREBASE_SERVICE_ACCOUNT=

# ── Swagger ──
# Leave unset to enable outside production and disable in production.
# Set explicitly to true/false to override.
# SWAGGER_ENABLED=true
SWAGGER_PATH=docs
